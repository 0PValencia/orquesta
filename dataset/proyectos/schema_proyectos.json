{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Informe de Proyecto de Sistemas de Información",
  "description": "Esquema completo para representar la estructura de un informe de proyecto de la materia Sistemas de Información I",
  "type": "object",
  "required": ["metadata", "profile", "system_elements", "technology", "costs_benefits", "clients", "theoretical_framework", "chapters"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["university", "faculty", "group", "course", "teacher", "location", "semester"],
      "properties": {
        "university": {
          "type": "string",
          "description": "Nombre de la universidad"
        },
        "faculty": {
          "type": "string",
          "description": "Nombre de la facultad"
        },
        "group": {
          "type": "string",
          "description": "Número o identificación del grupo"
        },
        "project_title": {
          "type": "string",
          "description": "Título del sistema de información a desarrollar"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "code": { "type": "string" }
            }
          },
          "description": "Lista de integrantes del grupo"
        },
        "course": {
          "type": "string",
          "description": "Nombre de la materia"
        },
        "course_code": {
          "type": "string",
          "description": "Sigla de la materia"
        },
        "teacher": {
          "type": "string",
          "description": "Nombre del docente"
        },
        "location": {
          "type": "string",
          "description": "Ciudad y país"
        },
        "semester": {
          "type": "string",
          "description": "Gestión y período académico"
        },
        "client_institution": {
          "type": "string",
          "description": "Institución o negocio cliente del proyecto"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["introduction", "background", "justification", "problem_description", "problem_formulation", "objectives", "scope"],
      "properties": {
        "introduction": {
          "type": "string",
          "description": "Introducción del proyecto (30-70 líneas)"
        },
        "background": {
          "type": "string",
          "description": "Antecedentes e investigación previa"
        },
        "justification": {
          "type": "string",
          "description": "Justificación e importancia del proyecto"
        },
        "problem_description": {
          "type": "object",
          "properties": {
            "sectors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "problems": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "description": "Problemas organizados por sector/área"
            }
          }
        },
        "problem_formulation": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Preguntas de investigación"
        },
        "objectives": {
          "type": "object",
          "properties": {
            "general": {
              "type": "string",
              "description": "Objetivo general del proyecto"
            },
            "specific": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Objetivos específicos (4-10 items)"
            }
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module_name": { "type": "string" },
              "description": { "type": "string" },
              "functional_requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          },
          "description": "Módulos funcionales del sistema"
        },
        "interview": {
          "type": "object",
          "properties": {
            "interviewee": { "type": "string" },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "question": { "type": "string" },
                  "answer": { "type": "string" }
                }
              }
            }
          },
          "description": "Entrevista al cliente/usuario (opcional)"
        }
      }
    },
    "system_elements": {
      "type": "object",
      "required": ["hardware", "software", "data", "processes", "users"],
      "properties": {
        "hardware": {
          "type": "object",
          "properties": {
            "server": {
              "type": "object",
              "properties": {
                "os": { "type": "string" },
                "processor": { "type": "string" },
                "ram": { "type": "string" },
                "storage": { "type": "string" }
              }
            },
            "client": {
              "type": "object",
              "properties": {
                "device": { "type": "string" },
                "specifications": { "type": "string" }
              }
            },
            "communication": {
              "type": "string"
            },
            "other_devices": {
              "type": "string"
            }
          }
        },
        "software": {
          "type": "object",
          "properties": {
            "server": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" },
                  "function": { "type": "string" }
                }
              }
            },
            "client": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" },
                  "function": { "type": "string" }
                }
              }
            },
            "additional": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" },
                  "function": { "type": "string" }
                }
              }
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "Entidades de datos principales"
        },
        "processes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Procesos principales del sistema actual"
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "Perfiles de usuario identificados"
        }
      }
    },
    "technology": {
      "type": "object",
      "required": ["strategy", "methodology", "tools"],
      "properties": {
        "strategy": {
          "type": "string",
          "description": "Estrategia general del desarrollo"
        },
        "methodology": {
          "type": "object",
          "properties": {
            "puds": {
              "type": "string",
              "description": "Características del Proceso Unificado"
            },
            "uml": {
              "type": "string",
              "description": "Características de UML"
            }
          }
        },
        "tools": {
          "type": "object",
          "properties": {
            "software": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" },
                  "purpose": { "type": "string" }
                }
              }
            },
            "hardware": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": { "type": "string" },
                  "specifications": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "costs_benefits": {
      "type": "object",
      "properties": {
        "costs": {
          "type": "object",
          "properties": {
            "development": { "type": "number" },
            "implementation": { "type": "number" },
            "total": { "type": "number" },
            "currency": { "type": "string" }
          }
        },
        "benefits": {
          "type": "object",
          "properties": {
            "time": { "type": "string" },
            "effort": { "type": "string" },
            "costs": { "type": "string" }
          }
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "location": { "type": "string" }
        }
      },
      "description": "Posibles clientes potenciales"
    },
    "theoretical_framework": {
      "type": "string",
      "description": "Marco teórico del proyecto"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_number", "title", "workflow_type"],
        "properties": {
          "chapter_number": { "type": "integer" },
          "title": { "type": "string" },
          "workflow_type": {
            "type": "string",
            "enum": ["ishikawa", "requirements_capture", "analysis", "design", "implementation", "testing"]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section_number": { "type": "string" },
                "title": { "type": "string" },
                "content": { "type": "string" },
                "subsections": {
                  "type": "array",
                  "items": { "$ref": "#" }
                }
              }
            }
          }
        }
      },
      "description": "Capítulos principales del informe"
    },
    "ishikawa_analysis": {
      "type": "object",
      "properties": {
        "initial_problems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "Lista inicial de problemas identificados"
        },
        "refined_problems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "Lista final de problemas tras depuración"
        },
        "problem_owners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "problem_id": { "type": "string" },
              "owners": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Categorías principales (espinas del pez)"
        },
        "change_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "related_problems": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "actors", "main_flow"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "summary": { "type": "string" },
          "actors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "initiating_actor": { "type": "string" },
          "main_flow": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Pasos del flujo principal numerados"
          },
          "precondition": { "type": "string" },
          "postcondition": { "type": "string" },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "action": { "type": "string" }
              }
            }
          },
          "cycle": {
            "type": "integer",
            "description": "Ciclo de desarrollo (1-4)"
          },
          "priority": {
            "type": "string",
            "enum": ["Alta", "Media", "Baja", "Crítica"]
          },
          "risk": {
            "type": "string",
            "enum": ["Alto", "Medio", "Bajo"]
          }
        }
      },
      "description": "Todos los casos de uso del sistema"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["primary", "secondary", "system"]
          },
          "description": { "type": "string" }
        }
      },
      "description": "Actores del sistema"
    },
    "database": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "size": { "type": "string" },
                    "nullable": { "type": "boolean" },
                    "key": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "stored_procedures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parameters": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "event": { "type": "string" },
              "table": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" },
              "sql": { "type": "string" }
            }
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "use_case": { "type": "string" },
          "description": { "type": "string" },
          "test_type": { "type": "string" },
          "priority": { "type": "string" },
          "input": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "value": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          },
          "expected_result": {
            "type": "array",
            "items": { "type": "string" }
          },
          "preconditions": { "type": "string" },
          "procedure": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "tables_figures": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "location": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "type": "string" },
              "location": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "conclusions": {
      "type": "string",
      "description": "Conclusiones del proyecto"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "recommendations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "bibliography": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "authors": { "type": "string" },
          "year": { "type": "string" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
